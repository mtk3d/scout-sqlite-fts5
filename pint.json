{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "concat_space": {
            "spacing": "none"
        },
        "php_unit_method_casing": {
            "case": "camel_case"
        }
    }
}
